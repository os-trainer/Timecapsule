{
  "name": "timecapsule",
  "version": "2.0.0",
  "description": "A lightweight developer utility for generating and visualizing structured Git histories, contribution timelines, and repository workflows.",
  "bin": {
    "timecapsule": "src/cli.js"
  },
  "main": "src/index.js",
  "files": [
    "src"
  ],
  "repository": "git@github.com:os-trainer/Timecapsule.git",
  "license": "MIT",
  "private": false,
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test tests/dates.test.js tests/integration.test.js tests/messages.test.js tests/templates.test.js",
    "lint": "prettier --write \"src/**/*.js\" \"tests/**/*.js\""
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*src/**/*.{js,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "boxen": "^4.2.0",
    "chalk": "4.1.0",
    "date-fns": "1.30.1",
    "meow": "13.2.0",
    "ora": "5.1.0"
  },
  "devDependencies": {
    "husky": "^4.3.0",
    "lint-staged": "^10.4.0",
    "prettier": "^1.19.1"
  },
  "keywords": [
    "git",
    "git-history",
    "commit-history",
    "github-contributions",
    "activity-graph",
    "timeline",
    "developer-tools"
  ]
}
